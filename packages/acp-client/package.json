{
  "name": "@xora-code/acp-client",
  "version": "0.2.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "commonjs",
  "description": "Small, dependency-free ACP JSON-RPC client for newline-delimited stdio transports",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "18.19.39",
    "typescript": "4.9.5"
  },
  "engines": {
    "node": ">=20"
  }
}
