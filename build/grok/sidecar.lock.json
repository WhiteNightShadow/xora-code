{
  "schemaVersion": 1,
  "upstream": {
    "repository": "https://github.com/xai-org/grok-build",
    "commit": "98c3b2438aa922fbbe6178a5c0a4c48f85edc8ce",
    "sourceRevision": "124d85bc5dc6e7805560215fcc6d5413944920e1",
    "version": "0.2.102",
    "license": "Apache-2.0"
  },
  "toolchain": {
    "rust": "1.92.0",
    "dotslash": "0.5.7",
    "protoc": "29.3",
    "cargoProfile": "release-dist",
    "cargoPackage": "xai-grok-pager-bin",
    "cargoBinary": "xai-grok-pager"
  },
  "bundledTools": {
    "ripgrep": {
      "package": "ripgrep",
      "version": "15.0.0",
      "binary": "rg",
      "source": "crates.io",
      "features": ["pcre2"]
    }
  },
  "sourcePatches": [
    {
      "id": "windows-portable-protoc-output-v1",
      "targets": ["win32-x64"],
      "file": "patches/0001-windows-portable-protoc-dependency-output.patch",
      "sha256": "2737876ec3d0f38947566218a24d0c66d83d5d12311138aff45c586e0ab80d46"
    }
  ],
  "runtime": {
    "packagedBinaryName": "grok",
    "args": ["--no-auto-update", "--cwd", "<root>", "agent", "--no-leader", "stdio"],
    "transport": "stdio",
    "protocol": "acp"
  },
  "targets": {
    "darwin-arm64": {
      "rustTarget": "aarch64-apple-darwin",
      "executableSuffix": ""
    },
    "darwin-x64": {
      "rustTarget": "x86_64-apple-darwin",
      "executableSuffix": ""
    },
    "linux-arm64": {
      "rustTarget": "aarch64-unknown-linux-gnu",
      "executableSuffix": ""
    },
    "linux-x64": {
      "rustTarget": "x86_64-unknown-linux-gnu",
      "executableSuffix": ""
    },
    "win32-x64": {
      "rustTarget": "x86_64-pc-windows-msvc",
      "executableSuffix": ".exe"
    }
  }
}
