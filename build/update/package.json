  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "18.19.39",
    "typescript": "4.9.5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
