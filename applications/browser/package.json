{
  "name": "@xora-code/browser-app",
  "version": "0.2.6",
  "private": true,
  "description": "Browser development target for the open-source Xora Code Grok desktop app and Grok Build GUI client.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25",
    "yarn": "1.22.22"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Xora Code",
        "defaultLocale": "zh-cn",
        "reloadOnReconnect": true,
        "preferences": {
          "toolbar.showToolbar": true,
          "security.workspace.trust.enabled": true,
          "window.title": "${appName}"
        }
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".xora-code",
        "resolveSystemPlugins": false,
        "frontendConnectionTimeout": 3000
      }
    }
  },
  "dependencies": {
    "@theia/bulk-edit": "1.73.1",
    "@theia/callhierarchy": "1.73.1",
    "@theia/core": "1.73.1",
    "@theia/debug": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/file-search": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/keymaps": "1.73.1",
    "@theia/markers": "1.73.1",
    "@theia/messages": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/navigator": "1.73.1",
    "@theia/outline-view": "1.73.1",
    "@theia/output": "1.73.1",
    "@theia/plugin-ext": "1.73.1",
    "@theia/plugin-ext-vscode": "1.73.1",
    "@theia/preferences": "1.73.1",
    "@theia/process": "1.73.1",
    "@theia/scm": "1.73.1",
    "@theia/search-in-workspace": "1.73.1",
    "@theia/task": "1.73.1",
    "@theia/terminal": "1.73.1",
    "@theia/toolbar": "1.73.1",
    "@theia/typehierarchy": "1.73.1",
    "@theia/userstorage": "1.73.1",
    "@theia/variable-resolver": "1.73.1",
    "@theia/vsx-registry": "1.73.1",
    "@theia/workspace": "1.73.1",
    "@xora-code/agent": "0.2.6",
    "@xora-code/product-extension": "0.2.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@theia/bundle-plugin": "1.73.1",
    "@theia/cli": "1.73.1",
    "rimraf": "6.0.1"
  },
  "scripts": {
    "clean": "theia clean && rimraf node_modules lib src-gen",
    "build": "yarn -s rebuild && theia build --app-target=browser --mode development",
    "build:prod": "yarn -s rebuild && theia build --app-target=browser",
    "rebuild": "theia rebuild:browser --cacheRoot ../..",
    "start": "theia start --plugins=local-dir:../../plugins"
  }
}
