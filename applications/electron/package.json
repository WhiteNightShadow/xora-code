{
  "name": "@xora-code/electron-app",
  "productName": "Xora Code",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source, model-neutral desktop Agent IDE built on Eclipse Theia, Electron, and ACP, with first-class Grok Build integration.",
  "author": {
    "name": "Xora Code contributors",
    "email": "WhiteNightShadow@users.noreply.github.com"
  },
  "homepage": "https://github.com/WhiteNightShadow/xora-code",
  "main": "scripts/theia-electron-main.js",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25",
    "yarn": "1.22.22"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Xora Code",
        "defaultLocale": "zh-cn",
        "reloadOnReconnect": true,
        "preferences": {
          "toolbar.showToolbar": false,
          "security.workspace.trust.enabled": true,
          "window.title": "${appName}",
          "files.watcherExclude": {
            "**/.git/objects/**": true,
            "**/.git/subtree-cache/**": true,
            "**/node_modules/**": true,
            "**/.browser_modules/**": true,
            "**/.yarn/**": true,
            "**/dist/**": true,
            "**/.next/**": true,
            "**/out/**": true,
            "**/target/**": true,
            "**/.cache/**": true
          }
        },
        "electron": {
          "uriScheme": "xora-code",
          "showWindowEarly": true,
          "splashScreenOptions": {
            "content": "resources/branding/splash.svg",
            "width": 640,
            "height": 360,
            "minDuration": 300,
            "maxDuration": 30000
          }
        }
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".xora-code",
        "resolveSystemPlugins": false,
        "frontendConnectionTimeout": -1,
        "startupTimeout": -1
      }
    }
  },
  "dependencies": {
    "@theia/bulk-edit": "1.73.1",
    "@theia/callhierarchy": "1.73.1",
    "@theia/core": "1.73.1",
    "@theia/debug": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/electron": "1.73.1",
    "@theia/external-terminal": "1.73.1",
    "@theia/file-search": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/keymaps": "1.73.1",
    "@theia/markers": "1.73.1",
    "@theia/messages": "1.73.1",
    "@theia/monaco": "1.73.1",
    "@theia/navigator": "1.73.1",
    "@theia/outline-view": "1.73.1",
    "@theia/output": "1.73.1",
    "@theia/plugin-ext": "1.73.1",
    "@theia/plugin-ext-vscode": "1.73.1",
    "@theia/preferences": "1.73.1",
    "@theia/process": "1.73.1",
    "@theia/scm": "1.73.1",
    "@theia/search-in-workspace": "1.73.1",
    "@theia/task": "1.73.1",
    "@theia/terminal": "1.73.1",
    "@theia/toolbar": "1.73.1",
    "@theia/typehierarchy": "1.73.1",
    "@theia/userstorage": "1.73.1",
    "@theia/variable-resolver": "1.73.1",
    "@theia/vsx-registry": "1.73.1",
    "@theia/workspace": "1.73.1",
    "@xora-code/agent": "0.1.0",
    "@xora-code/product-extension": "0.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@theia/bundle-plugin": "1.73.1",
    "@theia/cli": "1.73.1",
    "electron": "39.8.7",
    "electron-builder": "26.0.12",
    "rimraf": "6.0.1"
  },
  "scripts": {
    "clean": "theia clean && rimraf node_modules lib src-gen dist",
    "build": "yarn -s rebuild && theia build --app-target=electron --mode development",
    "build:prod": "node scripts/generate-third-party-licenses.js && yarn -s rebuild && theia build --app-target=electron",
    "generate:licenses": "node scripts/generate-third-party-licenses.js",
    "rebuild": "theia rebuild:electron --cacheRoot ../..",
    "test": "node --test test/*.test.cjs",
    "start": "electron scripts/theia-electron-main.js --plugins=local-dir:../../plugins",
    "package": "yarn verify:sidecar && yarn clean:dist && yarn build:prod && electron-builder --publish never",
    "package:preview": "yarn verify:sidecar:preview && yarn clean:dist && yarn build:prod && electron-builder --dir --publish never",
    "package:preview:installers": "node scripts/package-preview-installers.js",
    "sbom:preview": "node ../../build/sbom/generate-preview-sbom.mjs",
    "verify:sidecar": "node scripts/verify-sidecar.js",
    "verify:sidecar:preview": "node scripts/verify-sidecar.js --allow-missing --allow-unsigned-preview",
    "clean:dist": "rimraf dist"
  }
}
