  "description": "Xora Code ACP agent workbench",
  "license": "Apache-2.0",
  "dependencies": {
    "@theia/core": "1.73.1",
    "@theia/editor": "1.73.1",
    "@theia/electron": "1.73.1",
    "@theia/file-search": "1.73.1",
    "@theia/filesystem": "1.73.1",
    "@theia/navigator": "1.73.1",
    "@theia/toolbar": "1.73.1",
    "@theia/workspace": "1.73.1",
    "@xora-code/acp-client": "0.2.4",
    "@xora-code/runtime-core": "0.2.4",
    "@xora-code/update-build-tools": "0.2.4",
    "smol-toml": "1.6.1"
  },
  "devDependencies": {
    "rimraf": "2.7.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "18.3.1"
