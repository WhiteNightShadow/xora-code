{
  "name": "xora-code",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Xora Code: an agent-first desktop for coding agents",
  "license": "Apache-2.0",
  "homepage": "https://github.com/WhiteNightShadow/xora-code",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p build/tsconfig.json",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "keys:dev": "node build/keys.ts",
    "bundle": "node build/make-bundle.ts",
    "dev": "pnpm build && pnpm bundle && pnpm --filter @xora/desktop start",
    "package": "pnpm build && pnpm bundle && pnpm --filter @xora/desktop package",
    "drill": "pnpm build && pnpm bundle && node build/drill.ts",
    "smoke": "node build/ui-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@electron/fuses": "1.8.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
