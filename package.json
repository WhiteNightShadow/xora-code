{
  "name": "xora-code",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source, model-neutral desktop Agent IDE built on Eclipse Theia, Electron, and ACP, with first-class Grok Build integration.",
  "author": {
    "name": "Xora Code contributors",
    "email": "WhiteNightShadow@users.noreply.github.com"
  },
  "homepage": "https://github.com/WhiteNightShadow/xora-code",
  "license": "Apache-2.0",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <25",
    "yarn": "1.22.22"
  },
  "workspaces": [
    "applications/*",
    "build/*",
    "packages/*",
    "theia-extensions/*"
  ],
  "scripts": {
    "build": "yarn build:packages && yarn build:extensions && yarn build:applications",
    "build:dev": "yarn build",
    "build:packages": "lerna run build --scope '@xora-code/acp-client' --scope '@xora-code/fake-acp-agent' --scope '@xora-code/runtime-core' --scope '@xora-code/update-build-tools' --stream",
    "build:extensions": "lerna run build --scope '@xora-code/product-extension' --scope '@xora-code/agent' --stream",
    "build:applications": "lerna run build --scope '@xora-code/browser-app' --scope '@xora-code/electron-app' --concurrency 1 --stream",
    "clean": "lerna run clean --stream",
    "lint": "lerna run lint --stream",
    "test": "lerna run test --stream",
    "start:browser": "yarn workspace @xora-code/browser-app start",
    "start:electron": "yarn workspace @xora-code/electron-app start",
    "package:electron": "yarn workspace @xora-code/electron-app package",
    "package:electron:preview": "yarn workspace @xora-code/electron-app package:preview",
    "sbom:preview": "node build/sbom/generate-preview-sbom.mjs"
  },
  "devDependencies": {
    "lerna": "9.0.7",
    "rimraf": "6.0.1"
  }
}
